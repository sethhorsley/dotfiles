#!/bin/bash

set -eu

echo "==> 📦 After install - Clone repositories"

# gclo is installed during the main apply phase, which runs before this
# run_after script. Fall back gracefully if it is somehow missing.
gclo="$HOME/.local/bin/gclo"
if [[ ! -x "$gclo" ]]; then
  echo "gclo not found at $gclo; skipping repo clone" >&2
  exit 0
fi

# Repos come from .chezmoidata/repos.yaml. Listing them here also lets
# run_onchange re-run this script whenever repos.yaml changes.
# -t clones missing repos, skips existing ones, and does not touch repos.yaml.
{{- range .repos }}
"$gclo" -t {{ . | quote }}
{{- end }}
