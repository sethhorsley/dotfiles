# Mirrors ~/.config/wezterm/wezterm.lua (appearance only)
foreground = #CBE0F0
background = #011423
cursor-color = #47FF9C
cursor-text = #011423
selection-background = #706b4e
selection-foreground = #f3d9c4

# ansi 0-7, then brights 8-15
palette = 0=#214969
palette = 1=#E52E2E
palette = 2=#44FFB1
palette = 3=#FFE073
palette = 4=#0FC5ED
palette = 5=#a277ff
palette = 6=#24EAF7
palette = 7=#24EAF7
palette = 8=#214969
palette = 9=#E52E2E
palette = 10=#44FFB1
palette = 11=#FFE073
palette = 12=#A277FF
palette = 13=#a277ff
palette = 14=#24EAF7
palette = 15=#24EAF7

font-family = MesloLGS Nerd Font Mono
font-size = 15

background-opacity = 0.75
background-opacity-cells = true
background-blur = 8

window-decoration = auto
macos-titlebar-style = hidden
window-padding-x = 2
window-padding-y = 2
